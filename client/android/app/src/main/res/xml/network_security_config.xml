<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!--
      The PC is reached over plain HTTP at whatever LAN or hotspot address it has, which isn't
      known at build time. <domain> entries only match literal hostnames/IPs (not ranges like
      192.168.0.0/16), and when this file is present android:usesCleartextTraffic is ignored,
      so cleartext has to be allowed in base-config. Uploads are authenticated with the pair token.
    -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates source="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
